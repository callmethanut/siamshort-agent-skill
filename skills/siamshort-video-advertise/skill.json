{
  "schema_version": 1,
  "kind": "primary",
  "visibility": "user",
  "surfaces": [
    "studio",
    "canvas"
  ],
  "dependencies": [
    {
      "name": "siamshort-module-studio-platform",
      "load": "always"
    },
    {
      "name": "siamshort-module-prompt-laws",
      "load": "always"
    },
    {
      "name": "siamshort-module-image-recipes",
      "load": "conditional",
      "when": "writing any image prompt (stills, plates, boards, refs)"
    },
    {
      "name": "siamshort-module-video-recipes",
      "load": "always"
    },
    {
      "name": "siamshort-module-gen-loop",
      "load": "always"
    },
    {
      "name": "siamshort-module-storyboard-sheet",
      "load": "conditional",
      "when": "creating the concept board"
    },
    {
      "name": "siamshort-module-anti-plastic",
      "load": "conditional",
      "when": "presenter or photoreal product prompts"
    }
  ]
}
