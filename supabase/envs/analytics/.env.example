# ============================================================
# Agent Skill Enhancement — env: analytics
# Copy to .env (same folder) and fill. NEVER commit .env.
# Selected via:  SUPABASE_ENV=analytics python3 scripts/<tool>.py
# ============================================================

# --- Analytics Supabase project (the ONLY project these tools mutate) ---
# Management API (migrate.py / deploy_function.py):
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_KEY=

# Direct Postgres URI (bulk writes: etl_copy.py / tag_runs.py).
# Dashboard → Connect → URI (session pooler is fine).
ANALYTICS_DB_URL=postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres

# Password for the read-only `analyst` role (Supabase MCP analysis sessions).
# migrate.py substitutes this into 004_analyst_role.sql.
ANALYST_PASSWORD=

# --- SOURCES: live envs, READ-ONLY (etl_copy.py) ---
# Pattern: SRC_<NAME>_URL + SRC_<NAME>_SERVICE_KEY — auto-discovered;
# <NAME> lowercased becomes the `env` column value. Add/remove freely.

SRC_DEV_URL=
SRC_DEV_SERVICE_KEY=

SRC_MAIN_URL=
SRC_MAIN_SERVICE_KEY=

SRC_B2C_URL=
SRC_B2C_SERVICE_KEY=

SRC_SPINWILL_URL=
SRC_SPINWILL_SERVICE_KEY=

SRC_REALIFY_URL=
SRC_REALIFY_SERVICE_KEY=

SRC_CAVEMAN_URL=
SRC_CAVEMAN_SERVICE_KEY=

SRC_CEYE_URL=
SRC_CEYE_SERVICE_KEY=

# --- Tagging LLM (P4; leave empty until then) ---
TAGGING_PROVIDER=
TAGGING_API_KEY=
TAGGING_MODEL=
